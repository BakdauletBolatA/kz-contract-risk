# Все переменные необязательны: без них система работает в офлайн-режиме
# (правила + ML + in-memory поиск), LLM-слой выключен.

# LLM-классификатор. Без ключа гибрид работает в режиме rules+ml.
ANTHROPIC_API_KEY=
# Для /extract и extract eval с моделями OpenAI (openai:<модель>)
OPENAI_API_KEY=
# Другие модели для extract eval: grok:<модель>, deepseek:<модель> (диалект OpenAI)
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Адрес нативного Ollama. Не localhost: Docker-контейнеры с Ollama могут занимать тот же порт по IPv6
KZCR_OLLAMA_HOST=http://127.0.0.1:11434
KZCR_LLM_MODEL=claude-opus-5
# langchain (стек проекта) или anthropic (прямой SDK) — запрос одинаковый
KZCR_LLM_BACKEND=langchain
KZCR_LLM_EFFORT=medium

# pgvector. Без DSN эталонный корпус живёт в памяти процесса.
KZCR_DATABASE_URL=postgresql://kzcr:kzcr@localhost:5439/kzcr

# Эмбеддер: hashing (офлайн, по умолчанию) или e5 (нужен extra [embeddings]).
KZCR_EMBEDDER=hashing

# Streamlit ходит в API, если задан адрес; иначе вызывает пайплайн в процессе.
KZCR_API_URL=
